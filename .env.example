# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-telegram-bot-token

# ID календаря Google, за которым следит бот (значение по умолчанию —
# используется только при самом первом запуске, дальше меняется командой
# /set_calendar в Telegram, см. README.md).
# "primary" — основной календарь владельца сервис-аккаунта,
# либо email календаря вида xxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=primary

# Путь к JSON-ключу сервис-аккаунта Google (см. README.md)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Значения по умолчанию для первого запуска — дальше меняются командами
# /set_reminders, /set_interval, /set_lookahead, /set_timezone в Telegram.
REMINDER_MINUTES_BEFORE=60,10
POLL_INTERVAL_SECONDS=60
LOOKAHEAD_HOURS=24
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных подписчиков и отправленных напоминаний
DATABASE_PATH=bot_data.sqlite3

# chat_id (через запятую, можно несколько), которым разрешено менять
# настройки бота прямо в Telegram командами /config и /set_*.
# Свой chat_id можно узнать командой /whoami после первого запуска бота.
ADMIN_CHAT_IDS=
