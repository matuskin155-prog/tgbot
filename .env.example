# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-telegram-bot-token

# ID календаря Google, за которым следит бот (значение по умолчанию —
# используется только при самом первом запуске, дальше меняется командой
# /set_calendar в Telegram, см. README.md).
# "primary" — основной календарь владельца сервис-аккаунта,
# либо email календаря вида xxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=primary

# Путь к JSON-ключу сервис-аккаунта Google (см. README.md)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Значения по умолчанию для первого запуска — дальше меняются командами
# /set_reminders, /set_interval, /set_lookahead, /set_timezone,
# /set_digest_time в Telegram.
REMINDER_MINUTES_BEFORE=60,10
POLL_INTERVAL_SECONDS=60
LOOKAHEAD_HOURS=24
TIMEZONE=Europe/Moscow

# Во сколько присылать ежедневную сводку событий на сегодня (формат ЧЧ:ММ,
# по часовому поясу TIMEZONE)
DAILY_DIGEST_TIME=10:00

# Путь к файлу базы данных подписчиков и отправленных напоминаний
DATABASE_PATH=bot_data.sqlite3

# chat_id (через запятую, можно несколько), которым разрешено менять
# настройки бота прямо в Telegram командами /config и /set_*.
# Свой chat_id можно узнать командой /whoami после первого запуска бота.
ADMIN_CHAT_IDS=

# Путь к бинарнику браузера (Chrome/Chromium) для слежения за страницами
# олимпиад (bot/olympiad_watch.py). Если на сервере браузер уже установлен —
# укажите путь к нему, чтобы не ставить ещё один (узнать: which chromium
# или which google-chrome). Если оставить пустым, Selenium попробует найти
# браузер автоматически.
BROWSER_EXECUTABLE_PATH=

# Mini App (настоящее веб-приложение бота внутри Telegram) — см. README,
# раздел «Mini App». Нужен отдельный домен (не просто IP) с HTTPS.
#
# WEBAPP_DOMAIN — заполните, если разворачиваете через deploy.sh/
# deploy_from_pc.bat: он сам поставит Caddy, выпустит HTTPS-сертификат
# и подставит WEBAPP_URL ниже. Пример (бесплатный домен): mybot.duckdns.org
WEBAPP_DOMAIN=

# WEBAPP_URL — это то, что реально использует бот (кнопка "Открыть
# приложение"). При деплое через deploy.sh заполняется автоматически из
# WEBAPP_DOMAIN. Если настраиваете вручную (Docker, Вариант В) — впишите
# сюда полный адрес сами, например https://mybot.duckdns.org
WEBAPP_URL=

# Если сервер не может напрямую достучаться до серверов Telegram (бывает
# у некоторых хостингов/регионов — проверить: curl -v --max-time 15
# https://api.telegram.org/), укажите здесь HTTP- или SOCKS5-прокси для
# всего трафика бота к Telegram. Примеры:
#   TELEGRAM_PROXY_URL=http://login:password@proxy-host:port
#   TELEGRAM_PROXY_URL=socks5://login:password@proxy-host:port
# Google Calendar это не затрагивает — там отдельное подключение.
TELEGRAM_PROXY_URL=
